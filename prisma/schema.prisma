// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Relations
  memberships  WorkspaceMember[]
  messages     Message[]

  @@map("users")
}

// WHY AN EXPLICIT JOIN MODEL:
// Prisma supports implicit many-to-many (just @relation on both sides)
// but that gives you no place to store extra fields on the relationship.
// We need `role` on the membership itself — so we make it explicit.
model WorkspaceMember {
  id          String        @id @default(uuid())
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  // Foreign keys
  userId      String
  workspaceId String

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // A user can only have ONE membership per workspace
  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Relations
  members   WorkspaceMember[]
  channels  Channel[]

  @@map("workspaces")
}

model Channel {
  id          String    @id @default(uuid())
  name        String
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Foreign keys
  workspaceId String

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  // Channel names must be unique within a workspace
  @@unique([workspaceId, name])
  // Index speeds up "fetch all channels for workspace X" queries
  @@index([workspaceId])
  @@map("channels")
}

model Message {
  id        String    @id @default(uuid())
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  // Foreign keys
  channelId String
  authorId  String

  // Relations
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Composite index — speeds up "fetch latest N messages in channel X"
  // This is the most queried pattern in a chat app
  @@index([channelId, createdAt])
  @@map("messages")
}